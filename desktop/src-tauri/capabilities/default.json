{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Deny-by-default: only One's own commands, window dragging and event listening. No shell, fs, process or http plugins.",
  "windows": ["main"],
  "permissions": [
    "allow-list-voices",
    "allow-get-settings",
    "allow-save-settings",
    "allow-run-turn",
    "allow-approve-tool",
    "allow-deny-tool",
    "allow-cancel-turn",
    "allow-set-mode",
    "allow-key-status",
    "allow-team-load",
    "allow-team-set-done",
    "allow-team-remind",
    "allow-get-team-prefs",
    "allow-set-team-prefs",
    "allow-mic-start",
    "allow-mic-frames",
    "allow-mic-set-muted",
    "allow-mic-set-barge",
    "allow-list-sessions",
    "allow-focus-session",
    "allow-history-get",
    "allow-open-link",
    "allow-lock-state",
    "allow-test-voice",
    "allow-get-mode",
    "allow-mic-state",
    "allow-mic-set-ptt",
    "allow-new-session",
    "allow-hub-snapshot",
    "allow-hub-refresh",
    "allow-hub-ticket",
    "allow-hub-open-approval",
    "allow-hub-set-in-view",
    "allow-hub-nudge",
    "allow-session-route",
    "allow-session-pin",
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
