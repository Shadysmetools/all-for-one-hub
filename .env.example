# .env.example: copy to .env and fill in only what you use. Placeholders only; never commit .env.
#
# Nothing here is needed for the demo or the tests: `python -m allforone.demo` and `pytest` run on fakes.
# The hub does not read .env by itself. Export it into your shell first:
#   bash/zsh:   set -a; . ./.env; set +a
#   PowerShell: Get-Content .env | Where-Object { $_ -match '^[A-Z]' } | ForEach-Object { $k, $v = $_ -split '=', 2; Set-Item "env:$k" $v }

# ---- read by the Python adapters today ------------------------------------------------
# Speech to text (allforone.adapters.groq_stt, extra: pip install -e ".[groq]")
GROQ_API_KEY=your-groq-api-key
# Judge on Vertex AI (allforone.adapters.vertex, extra: pip install -e ".[vertex]"); uses Application Default Credentials
VERTEX_PROJECT=your-gcp-project-id
# Read-only Odoo helpdesk adapter (allforone.helpdesk.odoo_read)
ODOO_URL=https://odoo.example.com
ODOO_DB=your-database
ODOO_LOGIN=bot@example.com
ODOO_API_KEY=your-odoo-api-key
# Text to speech (allforone.tts.elevenlabs)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ---- reserved for the production entry point (listed in config.example.yaml; not wired yet) ----
WHATSAPP_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ---- desktop app (desktop/, read by the Rust side) ---------------------------------------
# Host of the hub's admin site that "Open to approve" opens: https://<host>/tickets/<id>. A bare hostname.
AFO_ADMIN_HOST=admin.example.com
# File holding the hub API bearer token (default: ~/.claude/secrets/hub-api-token.txt)
AFO_HUB_TOKEN_FILE=/path/to/hub-api-token.txt
# Path to the claude CLI if it is not on PATH
ONE_CLAUDE_BIN=/path/to/claude
